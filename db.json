CREATE TABLE public.abastecimiento_agua (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  id_predio uuid NOT NULL,
  nacimiento_manantial boolean DEFAULT false,
  rio_quebrada boolean DEFAULT false,
  pozo boolean DEFAULT false,
  acueducto_rural boolean DEFAULT false,
  canal_distrito_riego boolean DEFAULT false,
  jaguey_reservorio boolean DEFAULT false,
  agua_lluvia boolean DEFAULT false,
  otra_fuente character varying,
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT abastecimiento_agua_pkey PRIMARY KEY (id),
  CONSTRAINT abastecimiento_agua_id_predio_fkey FOREIGN KEY (id_predio) REFERENCES public.predios(id)
);
CREATE TABLE public.area_productiva (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  id_predio uuid NOT NULL,
  sistema_productivo character varying,
  caracterizacion_cultivo text,
  cantidad_produccion character varying,
  estado_cultivo character varying CHECK (estado_cultivo::text = ANY (ARRAY['Tecnificado'::character varying, 'En mal estado'::character varying, 'NS/NR'::character varying]::text[])),
  tiene_infraestructura_procesamiento boolean DEFAULT false,
  estructuras text,
  interesado_programa boolean DEFAULT false,
  donde_comercializa text,
  ingreso_mensual_ventas numeric,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT area_productiva_pkey PRIMARY KEY (id),
  CONSTRAINT area_productiva_id_predio_fkey FOREIGN KEY (id_predio) REFERENCES public.predios(id)
);
CREATE TABLE public.beneficiarios (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  id_visita uuid,
  nombres character varying NOT NULL,
  apellidos character varying NOT NULL,
  tipo_documento character varying NOT NULL CHECK (tipo_documento::text = ANY (ARRAY['CC'::character varying, 'CE'::character varying, 'TI'::character varying, 'PAS'::character varying, 'NIT'::character varying]::text[])),
  numero_documento character varying NOT NULL,
  edad integer,
  telefono character varying,
  correo character varying,
  ocupacion_principal character varying,
  foto_url character varying,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT beneficiarios_pkey PRIMARY KEY (id),
  CONSTRAINT beneficiarios_id_visita_fkey FOREIGN KEY (id_visita) REFERENCES public.visitas(id)
);
CREATE TABLE public.caracterizacion_predio (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  id_predio uuid NOT NULL UNIQUE,
  ruta_acceso text,
  distancia_km numeric,
  tiempo_acceso character varying,
  temperatura_celsius numeric,
  meses_lluvia character varying,
  topografia character varying CHECK (topografia::text = ANY (ARRAY['0-25% Plana'::character varying, '26-50% Inclinada'::character varying, '51%> Pendiente'::character varying]::text[])),
  cobertura_bosque boolean DEFAULT false,
  cobertura_cultivos boolean DEFAULT false,
  cobertura_pastos boolean DEFAULT false,
  cobertura_rastrojo boolean DEFAULT false,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT caracterizacion_predio_pkey PRIMARY KEY (id),
  CONSTRAINT caracterizacion_predio_id_predio_fkey FOREIGN KEY (id_predio) REFERENCES public.predios(id)
);
CREATE TABLE public.caracterizaciones (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  id_visita uuid NOT NULL,
  id_beneficiario uuid NOT NULL,
  id_predio uuid NOT NULL,
  observaciones text,
  foto_1_url character varying,
  foto_2_url character varying,
  firma_productor_url character varying,
  autorizacion_datos_personales boolean DEFAULT false,
  autorizacion_consulta_crediticia boolean DEFAULT false,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT caracterizaciones_pkey PRIMARY KEY (id),
  CONSTRAINT caracterizaciones_id_visita_fkey FOREIGN KEY (id_visita) REFERENCES public.visitas(id),
  CONSTRAINT caracterizaciones_id_beneficiario_fkey FOREIGN KEY (id_beneficiario) REFERENCES public.beneficiarios(id),
  CONSTRAINT caracterizaciones_id_predio_fkey FOREIGN KEY (id_predio) REFERENCES public.predios(id)
);
CREATE TABLE public.informacion_financiera (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  id_beneficiario uuid NOT NULL,
  ingresos_mensuales_agropecuaria numeric,
  ingresos_mensuales_otros numeric,
  egresos_mensuales numeric,
  activos_totales numeric,
  activos_agropecuaria numeric,
  pasivos_totales numeric,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT informacion_financiera_pkey PRIMARY KEY (id),
  CONSTRAINT informacion_financiera_id_beneficiario_fkey FOREIGN KEY (id_beneficiario) REFERENCES public.beneficiarios(id)
);
CREATE TABLE public.invitations (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  email character varying NOT NULL,
  token character varying NOT NULL UNIQUE,
  rol character varying DEFAULT 'asesor'::character varying,
  invitado_por uuid,
  usado boolean DEFAULT false,
  expires_at timestamp with time zone NOT NULL,
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT invitations_pkey PRIMARY KEY (id),
  CONSTRAINT invitations_invitado_por_fkey FOREIGN KEY (invitado_por) REFERENCES auth.users(id)
);
CREATE TABLE public.predios (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  id_beneficiario uuid NOT NULL,
  nombre_predio character varying,
  departamento character varying NOT NULL DEFAULT 'Santander'::character varying,
  municipio character varying NOT NULL,
  vereda character varying,
  direccion character varying,
  codigo_catastral character varying,
  documento_tenencia character varying,
  tipo_tenencia character varying CHECK (tipo_tenencia::text = ANY (ARRAY['Propia'::character varying, 'Posesion'::character varying, 'Arriendo'::character varying, 'Otro'::character varying]::text[])),
  tipo_tenencia_otro character varying,
  coordenada_x character varying,
  coordenada_y character varying,
  latitud numeric,
  longitud numeric,
  altitud_msnm numeric,
  vive_en_predio character varying CHECK (vive_en_predio::text = ANY (ARRAY['Si'::character varying, 'No'::character varying, 'Cerca'::character varying]::text[])),
  tiene_vivienda boolean DEFAULT false,
  area_total_hectareas numeric,
  area_productiva_hectareas numeric,
  cultivos_existentes text,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT predios_pkey PRIMARY KEY (id),
  CONSTRAINT predios_id_beneficiario_fkey FOREIGN KEY (id_beneficiario) REFERENCES public.beneficiarios(id)
);
CREATE TABLE public.profiles (
  id uuid NOT NULL,
  email character varying,
  nombre_completo character varying,
  rol character varying DEFAULT 'asesor'::character varying CHECK (rol::text = ANY (ARRAY['admin'::character varying, 'asesor'::character varying, 'campesino'::character varying]::text[])),
  telefono character varying,
  activo boolean DEFAULT true,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT profiles_pkey PRIMARY KEY (id),
  CONSTRAINT profiles_id_fkey FOREIGN KEY (id) REFERENCES auth.users(id)
);
CREATE TABLE public.riesgos_predio (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  id_predio uuid NOT NULL,
  inundacion boolean DEFAULT false,
  sequia boolean DEFAULT false,
  viento boolean DEFAULT false,
  helada boolean DEFAULT false,
  otros_riesgos text,
  created_at timestamp with time zone DEFAULT now(),
  CONSTRAINT riesgos_predio_pkey PRIMARY KEY (id),
  CONSTRAINT riesgos_predio_id_predio_fkey FOREIGN KEY (id_predio) REFERENCES public.predios(id)
);
CREATE TABLE public.visitas (
  id uuid NOT NULL DEFAULT gen_random_uuid(),
  fecha_visita date NOT NULL,
  nombre_tecnico character varying NOT NULL,
  codigo_formulario character varying,
  version_formulario character varying DEFAULT '1.0'::character varying,
  fecha_emision_formulario date,
  radicado_local character varying UNIQUE,
  radicado_oficial character varying UNIQUE,
  estado character varying DEFAULT 'PENDIENTE_SINCRONIZACION'::character varying,
  asesor_id uuid,
  created_at timestamp with time zone DEFAULT now(),
  updated_at timestamp with time zone DEFAULT now(),
  CONSTRAINT visitas_pkey PRIMARY KEY (id),
  CONSTRAINT visitas_asesor_id_fkey FOREIGN KEY (asesor_id) REFERENCES auth.users(id)
);